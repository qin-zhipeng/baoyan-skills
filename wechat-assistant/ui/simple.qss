/* 微信辅助器 · 极简界面：浅底 + 红色点缀，控件少、点击区域大 */
QWidget#root {
    background: #f6f7f9;
    font-family: "Microsoft YaHei UI", "Microsoft YaHei", sans-serif;
    color: #1f2329;
}
QLabel { font-family: "Microsoft YaHei UI", "Microsoft YaHei", sans-serif; color: #1f2329; }

/* ---------- 顶部 ---------- */
QWidget#header { background: #ffffff; border-bottom: 1px solid #eceef1; }
QLabel#brand { font-size: 14px; font-weight: 700; color: #1f2329; }
QPushButton#mini {
    border: 1px solid #e4e6ea; background: #ffffff; color: #5c626b;
    border-radius: 6px; padding: 5px 9px; font-size: 12px;
}
QPushButton#mini:hover { border-color: #e5484d; color: #e5484d; }
QPushButton#mini:checked { background: #e5484d; border-color: #e5484d; color: #ffffff; }

/* 顶部按钮单独收窄：三个按钮 + 品牌在 340px 吸附宽度里也排得开 */
#header QPushButton#primary { padding: 5px 9px; font-size: 12px; font-weight: 600; }
#header QPushButton#mini { padding: 5px 6px; }

QWidget#statusBar { background: #f0faf2; border-bottom: 1px solid #e3f0e6; }
QLabel#status { font-size: 12px; }
QLabel#status.warn { background: #fff6e8; color: #a06616; }

/* ---------- 页签 ---------- */
QWidget#tabBar { background: #ffffff; border-bottom: 1px solid #eceef1; }
QPushButton#tab {
    border: none; background: transparent; color: #7c828c;
    font-size: 12px; font-weight: 600; padding: 11px 2px; border-radius: 0;
}
QPushButton#tab:hover { color: #e5484d; }
QPushButton#tab:checked { color: #e5484d; border-bottom: 3px solid #e5484d; }

/* ---------- 输入 / 按钮 ---------- */
QLineEdit#search {
    border: 1px solid #e4e6ea; border-radius: 8px; background: #ffffff;
    padding: 8px 11px; font-size: 13px; color: #1f2329;
}
QLineEdit#search:focus { border-color: #e5484d; }
QPushButton#primary {
    background: #e5484d; color: #ffffff; border: none; border-radius: 8px;
    padding: 10px 14px; font-size: 13px; font-weight: 600;
}
QPushButton#primary:hover { background: #d43b40; }
QPushButton#primary:disabled { background: #d9dce1; color: #ffffff; }
QPushButton#outline {
    background: #ffffff; color: #e5484d; border: 1px dashed #e9a5a7;
    border-radius: 8px; padding: 9px 12px; font-size: 13px;
}
QPushButton#outline:hover { background: #fff5f5; border-style: solid; }
QPushButton#soft {
    background: #ffffff; color: #4a5058; border: 1px solid #e4e6ea;
    border-radius: 8px; padding: 8px 12px; font-size: 12px;
}
QPushButton#soft:hover { border-color: #e5484d; color: #e5484d; }
QToolButton#tiny {
    border: none; background: transparent; color: #a6abb3;
    font-size: 12px; padding: 3px 5px; border-radius: 5px;
}
QToolButton#tiny:hover { background: #fdecec; color: #e5484d; }

/* ---------- 客户名单页 ---------- */
QPushButton#srcBtn {
    background: #ffffff; color: #4a5058; border: 1px solid #e4e6ea;
    border-radius: 7px; padding: 6px 3px; font-size: 11px;
}
QPushButton#srcBtn:hover { border-color: #e5484d; color: #e5484d; }
QPushButton#srcBtn:disabled { color: #b7bbc2; }
QPushButton#seg {
    border: 1px solid #e4e6ea; background: #ffffff; color: #6b717a;
    border-radius: 8px; padding: 8px 4px; font-size: 12px; font-weight: 600;
}
QPushButton#seg:hover { border-color: #eda9ab; color: #e5484d; }
QPushButton#seg:checked { background: #fdecec; border-color: #e5484d; color: #e5484d; }

/* ---------- 卡片 ---------- */
QFrame#card {
    background: #ffffff; border: 1px solid #e8eaee; border-radius: 10px;
}
QFrame#card:hover { border-color: #eda9ab; background: #fffafa; }
QLabel#cardTitle { font-size: 13px; font-weight: 600; color: #23272e; }
QLabel#cardPreview { font-size: 11px; color: #9aa0a8; }
QLabel#emptyHint { font-size: 12px; color: #a2a7af; }

QScrollArea { border: none; background: transparent; }
QWidget#scrollContent { background: transparent; }
QScrollBar:vertical { background: transparent; width: 7px; margin: 0; }
QScrollBar::handle:vertical { background: #d8dbe0; border-radius: 4px; min-height: 26px; }
QScrollBar::handle:vertical:hover { background: #b9bec6; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

/* ---------- 底部 ---------- */
QWidget#footer { background: #ffffff; border-top: 1px solid #eceef1; }
QLabel#footerTip { font-size: 11px; color: #9aa0a8; }

/* ---------- 打标签页 ---------- */
QLabel#step { font-size: 12px; color: #5c626b; line-height: 150%; }
QFrame#panel { background: #ffffff; border: 1px solid #e8eaee; border-radius: 10px; }
QCheckBox, QRadioButton { font-size: 12px; color: #4a5058; spacing: 5px; }
QSpinBox, QComboBox {
    border: 1px solid #e4e6ea; border-radius: 6px; background: #ffffff;
    padding: 4px 7px; font-size: 12px; color: #3a3f47;
}
QSpinBox:hover, QComboBox:hover { border-color: #eda9ab; }
QSpinBox:focus, QComboBox:focus { border-color: #e5484d; }
QSpinBox:disabled, QComboBox:disabled { background: #f6f7f9; color: #b7bbc2; }
/* Windows 原生上下箭头带一圈深色描边（用户看到的「黑边」）。
   把按钮和箭头画成透明无边框，但**保留按钮占位**：
   若用 setButtonSymbols(NoButtons) 或把按钮宽设 0，Qt 会把内部
   lineEdit 压成 1px，数字就显示不出来（本项目实测踩过这个坑）。 */
QSpinBox::up-button, QSpinBox::down-button {
    background: transparent; border: none; width: 14px;
}
QSpinBox::up-arrow, QSpinBox::down-arrow {
    image: none; width: 0; height: 0; border: none;
}
QProgressBar {
    border: none; background: #eceef1; border-radius: 5px; height: 9px; text-align: center;
}
QProgressBar::chunk { background: #e5484d; border-radius: 5px; }
QPlainTextEdit#logBox {
    background: #ffffff; border: 1px solid #e8eaee; border-radius: 8px;
    font-size: 11px; color: #5c626b; font-family: "Microsoft YaHei UI", sans-serif;
}

/* ---------- 对话框 ---------- */
QDialog { background: #f6f7f9; font-family: "Microsoft YaHei UI", sans-serif; }
QPlainTextEdit, QLineEdit {
    border: 1px solid #e4e6ea; border-radius: 8px; background: #ffffff;
    padding: 8px 10px; font-size: 13px; color: #1f2329;
}
QPlainTextEdit:focus, QLineEdit:focus { border-color: #e5484d; }
QLabel#hint { font-size: 11px; color: #9aa0a8; }
